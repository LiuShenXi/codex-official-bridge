# Export these variables, or use node --env-file=.env src/main.mjs.
BRIDGE_API_KEY=replace-with-a-random-local-key
BRIDGE_PORT=8789
BRIDGE_CODEX_BIN=codex
# Native desktop mode requires npm run build:native first.
BRIDGE_MODE=native
# BRIDGE_NATIVE_BIN=/absolute/path/to/codex-official-runtime
BRIDGE_NATIVE_STARTUP_TIMEOUT_MS=120000
# Legacy function-only demo remains available with BRIDGE_MODE=legacy.
# Separate login state by default: <project>/.runtime/codex-home
# BRIDGE_CODEX_HOME=/absolute/path/to/dedicated/codex-home
# Optional default model. If omitted, clients must provide model.
# BRIDGE_MODEL=your-available-model
# Upper bounds for one HTTP generation and a paused tool call.
BRIDGE_REQUEST_TIMEOUT_MS=120000
BRIDGE_SESSION_TTL_MS=300000

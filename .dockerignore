# An allowlist prevents auth.json, .env, keys, logs, vendor trees, and local
# build products from ever being sent to the Docker daemon as context.
**
!Dockerfile
!.dockerignore
!package.json
!src/
!src/**
!scripts/
!scripts/**
!examples/
!examples/**
!native-runtime/
!native-runtime/Cargo.toml
!native-runtime/Cargo.lock
!native-runtime/src/
!native-runtime/src/**

!test/
!test/**

# Capture archives and keys must stay outside every future build context.
**/__pycache__/**
**/*.pyc
scripts/request-capture/private/**
scripts/request-capture/runs/**
scripts/request-capture/records/**
scripts/request-capture/capture-config.json
scripts/request-capture/**/*.cap
scripts/request-capture/**/*.dpapi
scripts/request-capture/**/*.pem
